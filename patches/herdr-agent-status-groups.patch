+pub(super) fn label_priority_groups<'a>(rows: impl IntoIterator<Item = &'a mut AgentRow>) {
+    let mut previous_group = None;
+    for row in rows {
+        let group = AgentPriorityGroup::for_status(row.status);
+        let starts_group = previous_group != Some(group);
+        row.group_label = starts_group.then_some(group.label());
