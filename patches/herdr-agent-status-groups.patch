+impl AgentPriorityGroup {
+    fn for_status(status: crate::api::schema::AgentStatus) -> Self {
+        use crate::api::schema::AgentStatus;
+        match status {
+            AgentStatus::Blocked | AgentStatus::Done => Self::NeedsYou,
+            AgentStatus::Working => Self::Working,
+            AgentStatus::Idle | AgentStatus::Unknown => Self::Quiet,
+        }
+    }
+
+    fn label(self) -> &'static str {
+        match self {
+            Self::NeedsYou => " NEEDS YOU",
+            Self::Working => " WORKING",
+            Self::Quiet => " QUIET",
+        }
+    }
+}
