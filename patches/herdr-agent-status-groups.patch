+#[cfg(test)]
+mod tests {
+    use super::*;
+    use crate::api::schema::AgentStatus;
+
+    #[test]
+    fn priority_groups_match_attention_workflow() {
+        assert_eq!(
+            AgentPriorityGroup::for_status(AgentStatus::Blocked).label(),
+            " NEEDS YOU"
+        );
+        assert_eq!(
+            AgentPriorityGroup::for_status(AgentStatus::Done).label(),
+            " NEEDS YOU"
+        );
+        assert_eq!(
+            AgentPriorityGroup::for_status(AgentStatus::Working).label(),
+            " WORKING"
+        );
+        assert_eq!(
+            AgentPriorityGroup::for_status(AgentStatus::Idle).label(),
+            " QUIET"
+        );
+        assert_eq!(
+            AgentPriorityGroup::for_status(AgentStatus::Unknown).label(),
+            " QUIET"
+        );
+    }
+
+    #[test]
+    fn priority_groups_add_spacing_between_sections() {
+        let mut rows = [
+            AgentStatus::Blocked,
+            AgentStatus::Done,
+            AgentStatus::Working,
+            AgentStatus::Idle,
+        ]
+        .map(|status| AgentRow {
+            pane_id: String::new(),
+            status,
+            focused: false,
+            rows: Vec::new(),
+            group_label: None,
+            group_spacing: false,
+        });
+
+        label_priority_groups(rows.iter_mut());
+
+        assert_eq!(rows.each_ref().map(|row| row.line_count()), [2, 1, 3, 3]);
+        assert_eq!(rows[0].content_rect(Rect::new(0, 0, 10, 2)).y, 1);
+        assert_eq!(rows[2].content_rect(Rect::new(0, 0, 10, 3)).y, 2);
+    }
+}
